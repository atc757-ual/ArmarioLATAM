@inherits LayoutComponentBase

<div class="app-shell">

    <header class="app-header">
        <div class="header-left">
            <img src="images/logo.svg" alt="Logo" class="header-logo" />
        </div>

        @if (isLogin)
        {
            <div class="header-right">
                <div class=""><img src="images/ico_burger.svg" /></div>
            </div>
           
        }
    </header>
    <main class="app-main">
        @if(isLogin)
        {
            <NavMenu />
        }
        @Body
    </main>
    <footer class="app-footer">
        <img src="images/logo_footer.svg" alt="MiApp" class="footer-logo-img" />
        <span class="footer-text">
            Si tienes alguna duda o requieres soporte técnico por favor escríbenos a
            armariolatam@mail.com
        </span>
    </footer>

    @if (IsLoading)
    {
        <div class="latam-loading-overlay">
            <div class="latam-spinner"></div>
            @* <div class="latam-dots"><span></span><span></span><span></span></div> *@
        </div>
    }
</div>

@code {
    public bool isLogin { get; set; } = true;
    public bool IsLoading { get; set; } = false;
}