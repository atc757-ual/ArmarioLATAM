@page "/Administrador"
@rendermode InteractiveServer

@using ArmarioLATAM.Components.Models
@using System.ComponentModel.DataAnnotations
@inject NavigationManager NavigationManager

@using System.Linq

<section class="latam-section">
    <div class="title-dashboard">
        Administrador
    </div>
    @* TAB MOBILE con botones *@
    <div class="latam-kits-row">
        <div class="latam-kit-wrapper">
            <button class="latam-kit @(selectedTab == 1 ? "active" : "")"
                    @onclick="() => SelectTab(1)">
                @if (selectedTab == 1)
                {
                    <img src="images/ico_new_blue.svg" alt="" />
                }
                else
                {
                    <img src="images/ico_new.svg" alt="" />
                }
                <span class="latam-kit-label">Actuar como otro usuario</span>
            </button>
            <div class="latam-kit-panel latam-kit-panel--mobile">
                @* PANEL MÓVIL pegado al tab activo *@
                @if (selectedTab == 1)
                {

                    <EditForm FormName="fomBP"
                              Model="@adminModel"
                              OnValidSubmit="@Search">
                        <DataAnnotationsValidator />
                        @if (step == 1 || step == 0)
                        {
                            <div class="admin-desktop">
                                <div class="admin-desktop-field">
                                    <label for="inputbp">BP usuario</label>
                                    <InputText id="inputbp"
                                               name="BP"
                                               class="latam-input"
                                               @onblur="OnBPBlur"
                                               @bind-Value="adminModel.BPSearch"
                                               placeholder="Ingresa BP" />
                                    <ValidationMessage For="@(() => adminModel.BPSearch)"
                                                       class="validation-message" />
                                </div>
                                @if (step == 0)
                                {
                                    <div class="admin-desktop-button">
                                        <div></div>
                                        @if (isValidBP)
                                        {
                                            <button class="latam-btn latam-btn--primary" type="submit">
                                                Buscar
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="latam-btn latam-btn--primary" disabled>
                                                Buscar
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </EditForm>

                    @if (step == 1)
                    {
                        <div class="latam-user-summary">
                            <div class="user-row">
                                <span class="user-label">Nombre</span>
                                <span class="user-value">@usuarioModel.Nombre</span>
                            </div>
                            <div class="user-row">
                                <span class="user-label">Género</span>
                                <span class="user-value">@usuarioModel.Genero</span>
                            </div>
                            <div class="user-row">
                                <span class="user-label">Correo</span>
                                <span class="user-value">@usuarioModel.Correo</span>
                            </div>
                            <div class="user-row">
                                <span class="user-label">Documento</span>
                                <span class="user-value">@usuarioModel.Documento</span>
                            </div>
                            <div class="latam-modal-footer">
                                <button class="latam-btn latam-btn--primary"
                                        type="button"
                                        @onclick="ActuarComo">
                                    Actuar como este usuario
                                </button>
                                <a class="latam-link-primary" @onclick="Limpiar">
                                    Limpiar
                                </a>
                            </div>
                        </div>
                    }
                    else if (step == 2)
                    {
                        <div class="userselect-row">
                            <div>
                                <p><strong>Actuando como</strong></p>
                                <p>@usuarioModel.Nombre</p>
                            </div>
                            <span class="display-flex">
                                <a class="latam-link-danger" @onclick="Recuperar">
                                    Recuperar mi sesión
                                </a>
                            </span>
                        </div>
                    }
                    else if (step == 2)
                    {
                        <div class="latam-user-summary">
                            <div class="latam-user-summary-row">
                                <div>
                                    <p><strong>Actuando como</strong></p>
                                    <p>@usuarioModel.Nombre</p>
                                </div>
                            </div>
                        </div>
                        <div class="margin-top-m">
                            <a class="latam-link-primary" @onclick="Limpiar">
                                Limpiar
                            </a>
                        </div>
                    }
                }

            </div>
        </div>
        <div class="latam-kit-wrapper">
            <button class="latam-kit @(selectedTab == 2 ? "active" : "")"
                    @onclick="() => SelectTab(2)">
                @if (selectedTab == 2)
                {
                    <img src="images/ico_solicitud_blue.svg" alt="" />
                }
                else
                {
                    <img src="images/ico_solicitud.svg" alt="" />
                }
                <span class="latam-kit-label">Solicitudes pendientes</span>
            </button>

            @if (selectedTab == 2)
            {
                <div class="border-bottom-separator"></div>
                <div class="latam-kit-panel latam-kit-panel--mobile">
                    <div class="solicitudes-list mobile-only">
                        @foreach (var s in SolicitudesVisibles)
                        {
                            <div class="solicitud-card">
                                <input type="radio" class="radio-form"
                                       name="solicitud-mobile" value="@s.check"
                                       @onchange="(e => OnRadioChange(s))" />
                                <div>
                                    <span>@s.Nombre</span>
                                    <div class="solicitud-meta">
                                       <div> 
                                            <span class="label">BP</span>
                                            <span class="value">@s.BP</span>
                                        </div>
                                        <div class="padding-left-base">
                                            <span class="label">Orden</span>
                                            <span class="value">@s.Orden</span>
                                        </div> 
                                    </div>
                                </div>
                                <button type="button" class="icon-btn" @onclick="verDetalle">
                                    <img src="images\ico_vermas.svg" />
                                </button>
                            </div>
                        }
                    </div>
                    @if (CantidadVisible < Solicitudes.Count)
                    {
                        <div class="mas-solicitudes mobile-only">
                            <a class="mas-solicitudes-link" @onclick="VerMas">
                                <span>Más solicitudes</span>
                                <img src="images/ico_add_circle.svg" />
                            </a>
                        </div>
                    }
                    <div class="buttons-solicitudes">
                        @if (hasCheck)
                        {
                            <button class="latam-btn latam-btn--primary" type="button" @onclick="Aprobar">
                                Aprobar
                            </button>
                        }
                        else
                        {
                            <button class="latam-btn latam-btn--primary" disabled>
                                Aprobar
                            </button>
                        }
                        <a class="latam-link-danger" @onclick="Rechazar">
                            Rechazar
                        </a>
                    </div>

                </div>

            }

        </div>
    </div>

    @* TAB DESKTOP con botones *@
    <div class="latam-kit-panel latam-kit-panel--desktop">
        @if (selectedTab == 1)
        {
            <EditForm FormName="fomBP"
                      Model="@adminModel"
                      OnValidSubmit="@Search">
                <DataAnnotationsValidator />
                @if (step == 1 || step == 0)
                {

                    <div class="admin-desktop">
                        <div class="admin-desktop-field">
                            <label for="inputbp">BP usuario</label>
                            <InputText id="inputbp"
                                       name="BP"
                                       class="latam-input"
                                       @onblur="OnBPBlur"
                                       @bind-Value="adminModel.BPSearch"
                                       placeholder="Ingresa BP" />
                            <ValidationMessage For="@(() => adminModel.BPSearch)"
                                               class="validation-message" />
                        </div>
                        @if (step == 0)
                        {
                            <div class="admin-desktop-button">
                                <div></div>
                                @if (isValidBP)
                                {
                                    <button class="latam-btn latam-btn--primary" type="submit">
                                        Buscar
                                    </button>
                                }
                                else
                                {
                                    <button class="latam-btn latam-btn--primary" disabled>
                                        Buscar
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

            </EditForm>

            @if (step == 1)
            {
                <div class="latam-user-summary">
                    <div class="latam-user-summary-row">
                        <div>
                            <p><strong>Nombre</strong></p>
                            <p>@usuarioModel.Nombre</p>
                        </div>
                        <div>
                            <p><strong>Género</strong></p>
                            <p>@usuarioModel.Genero</p>
                        </div>
                        <div>
                            <p><strong>Correo</strong></p>
                            <p>@usuarioModel.Correo</p>
                        </div>
                        <div>
                            <p><strong>Documento</strong></p>
                            <p>@usuarioModel.Documento</p>
                        </div>
                    </div>
                    <Separator></Separator>
                    <div class="latam-modal-footer">
                        <button class="latam-btn latam-btn--primary"
                                type="button"
                                @onclick="ActuarComo">
                            Actuar como este usuario
                        </button>
                        <a class="latam-link-primary" @onclick="Limpiar">
                            Limpiar
                        </a>
                    </div>
                </div>
            }
            else if (step == 2)
            {
                <div class="padding-base">
                    <div class="userselect-row">
                        <p><strong>Actuando como</strong></p>
                        <p>@usuarioModel.Nombre</p>
                        <a class="latam-link-danger" @onclick="Recuperar">
                            Recuperar mi sesión
                        </a>
                    </div>
                </div>

            }
        }
        else if (selectedTab == 2)
        {
            <table class="solicitudes-table desktop-only">
                <thead>
                    <tr>
                        <th></th>
                        <th>Nombre</th>
                        <th>BP</th>
                        <th>Orden</th>
                        <th>Precio (US)</th>
                        <th>Kit</th>
                        <th>Ver detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in SolicitudesVisibles)
                    {
                        <tr>
                            <td>
                                <input class="radio-form" type="radio" name="solicitud"
                                       value="@s.check"
                                       @onchange="(e => OnRadioChange(s))" />
                            </td>
                            <td>@s.Nombre</td>
                            <td>@s.BP</td>
                            <td>@s.Orden</td>
                            <td>@s.Precio</td>
                            <td>@s.Kit</td>
                            <td>
                                <button type="button" class="icon-btn" @onclick="verDetalle">
                                    <img src="images/ico_vermas.svg" />
                                </button>
                            </td>
                        </tr>

                    }
                </tbody>
            </table>
            @if (CantidadVisible < Solicitudes.Count)
            {
                <div class="mas-solicitudes desktop-only">
                    <a class="mas-solicitudes-link" @onclick="VerMas">
                        <span>Más solicitudes</span>
                        <img src="images/ico_add_circle.svg" />
                    </a>
                </div>
            }

            <div class="buttons-solicitudes">
                @if (hasCheck)
                {
                    <button class="latam-btn latam-btn--primary" type="button" @onclick="Aprobar">
                        Aprobar
                    </button>
                }
                else
                {
                    <button class="latam-btn latam-btn--primary" disabled>
                        Aprobar
                    </button>
                }
                <a class="latam-link-danger" @onclick="Rechazar">
                    Rechazar
                </a>
            </div>
        }

    </div>
       

    @if (step == 2)
    {
        <Dashboard />
    }
    <ModalDetalle Visible="@MostrarModal" Orden="319070" items="KitDetail" Kit="Kit" OnClosed="@CerrarDetalle" />
     <Toast Visible="@MostrarToast" Title="@title" Message="@message" Type="@type" OnClosed="@ToastCerrado" />

</section>
@code {
    private bool MostrarToast;
    private bool MostrarModal;
    private string OrdenAprobada { get; set; } = "";
    private bool isValidBP = false;
    private int selectedTab = 0;
    private void SelectTab(int tab) => selectedTab = tab;
    private int step { get; set; } = 0;
    private string? title { get; set; }
    private string? message { get; set; }
    private string? type { get; set;}
    private bool success { get; set; } = true;
    public AdminModel adminModel = new();
    public UsuarioModel usuarioModel = new();


    private void OnBPBlur(FocusEventArgs e)
    {
        var results = new List<ValidationResult>();
        var context = new ValidationContext(adminModel)
        {
            MemberName = nameof(AdminModel.BPSearch)
        };

        isValidBP = Validator.TryValidateProperty(
            adminModel.BPSearch,
            context,
            results);

        StateHasChanged();
    }

    private void Search()
    {
        // TODO: llamada a servicio / lista
        usuarioModel = new UsuarioModel
        {
            Nombre = "Quiroga Juan Camilo",
            Genero = "Masculino",
            Correo = "quirogajuan@latam.com",
            Documento = "12387441-K"
        };
        step = 1;
    }

    private List<SolicitudModel> Solicitudes = new()
