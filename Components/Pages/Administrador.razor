    private int CantidadVisible = 5;
    private IEnumerable<SolicitudModel> SolicitudesVisibles => Solicitudes.Take(CantidadVisible);
    bool hasCheck { get; set; } = false;
    private void OnRadioChange(SolicitudModel s)
    {
        foreach (var item in Solicitudes)
            item.check = false;
        s.check = true;
        hasCheck = Solicitudes.Any(x => x.check);
    }
    private KitModel Kit = new()
        {
            Precio = "18,48 US",
            KitName = "Crew Female Inicial CO Emergencia",
            Motivo = "Rotura"
        };
    private void Limpiar()
    {
        usuarioModel = new();
        step = 0;
    }
    private void ActuarComo()
    {
        step = 2;
    }
    private void Recuperar()
    {
        Limpiar();
    }
    private void VerMas()
    {
        if (CantidadVisible < Solicitudes.Count)
        {
            CantidadVisible = Math.Min(CantidadVisible + 5, Solicitudes.Count);
        }
    }
    private void Aprobar()
    {
        if (success)
        {
            title = "¡Solicitud aprobada!";
            message = "Orden 567890 aprobada con éxito";
            type = "success";
        }
        else
        {
            title = "¡Ha ocurrido un error";
            message = "No hemos podido aprobar la orden 567890";
            type = "error";
        }
        MostrarToast = false;
        StateHasChanged();
        MostrarToast = true;
    }
    private void Rechazar()
    {

        if (success)
        {
            title = "¡Solicitud rechazada!";
            message = "Orden 567890 rechazada con éxito";
            type = "info";
        }
        else
        {
            title = "¡Ha ocurrido un error";
            message = "No hemos podido rechazar la orden 567890";
            type = "error";
        }

        MostrarToast = false;
        StateHasChanged();
        MostrarToast = true;
    }
    private void ToastCerrado()
    {
        MostrarToast = false;
    }
    private void verDetalle()
    {
        MostrarModal = true;
    }
    private void CerrarDetalle()
    {
        MostrarModal = false;
    }
}