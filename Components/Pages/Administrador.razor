        new() { check = false, Nombre = "Suárez Daniela Marcela", BP = "5342103", Orden = "319077", Precio = "19,10 US", Kit = "Crew Female Reposición CO Emergencia" },
        new() { check = false, Nombre = "Herrera Miguel Ángel", BP = "5451204", Orden = "319078", Precio = "22,30 US", Kit = "Crew Male Reposición CO Emergencia" },
        new() { check = false, Nombre = "Rojas Camila Isabel", BP = "5564305", Orden = "319079", Precio = "17,95 US", Kit = "Crew Female Inicial Internacional" },
