        new() { Nombre = "Calça-Bermuda Unissex Azul", Talla = "S", Cantidad = 1, PrecioUnitario = "$29,24", Total = "$18,48" },
        new() { Nombre = "Camisa Unissex Blanca",      Talla = "L", Cantidad = 1, PrecioUnitario = "$15,00", Total = "$15,00" },
        new() { Nombre = "Camisa Unissex Blanca",      Talla = "M", Cantidad = 1, PrecioUnitario = "$15,00", Total = "$15,00" },
        new() { Nombre = "Camisa Unissex Blanca",      Talla = "S", Cantidad = 1, PrecioUnitario = "$15,00", Total = "$15,00" },
        new() { Nombre = "Chaqueta Azul Unissex",      Talla = "L", Cantidad = 1, PrecioUnitario = "$45,00", Total = "$45,00" },
