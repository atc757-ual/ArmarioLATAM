        new() { check = false, Nombre = "López Diego Andrés",BP = "5012398",Orden = "319074",Precio = "20,00 US",Kit = "Crew Male Reposición Internacional"},
        new() { check = false, Nombre = "Martínez Paula Andrea", BP = "5123401", Orden = "319075", Precio = "21,50 US", Kit = "Crew Female Inicial CO Emergencia" },
