@page "/NuevoIngresoComprobante"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager Navigation

<section class="latam-section">
    <div class="page-title">Nuevo ingreso</div>
    <Separator />
    <div class="nuevo-ingreso-header">
        <span class="label">Comprobante de solicitud:</span><br class="mobile-break" /> <span class="label">Apto Outdoor Unisex</span>
    </div>
    <div class="success-card">
        <header class="success-card-header">
            <img src="images\ico_check_success.svg" />
            <div class="success-title">
                ¡Felicidades! Tu solicitud de uniforme se ha generado con éxito
            </div>
        </header>
        <Separator />
        <div class="success-card-body">
            <p class="success-text">
                Tu pedido ha sido confirmado exitosamente y se encuentra en proceso de producción y despacho.
            </p>

            <div>
                <div>
                    <span class="success-data-label">Número de orden:</span>
                    <span class="success-data-value">320803</span>
                </div>
                <div class="margin-top-base">
                    <span class="success-data-label">Fecha de solicitud:</span>
                    <span class="success-data-value">15/05/2024</span>
                </div>
            </div>

            <p>
                Te notificaremos cuando el pedido se encuentre listo para ser retirado.
            </p>
        </div>
    </div>

            <div class="latam-btn-row">
                <button type="button" class="latam-btn latam-btn--primary " @onclick="GoNext">Volver al inicio</button>
            </div>
 
</section>
@code {

    void GoNext()
    {
        Navigation.NavigateTo("/Dashboard");
    }

}
