@rendermode InteractiveServer

@using ArmarioLATAM.Components.Models
@using System.ComponentModel.DataAnnotations

@if (Visible)
{
    <div class="kit-detail">
        <div class="kit-detail__panel">

           
            <div class="kit-detail-mobile">
                <div class="kit-detail__header">
                    <span>Orden @Orden</span>
                </div>
                <Separator></Separator>
                <!-- fichas móviles -->
                <div class="kit-card-header">
                    <div class="label">Precio</div><span>@Kit.Precio</span>
                    <div class="label">Kit</div><span>@Kit.KitName</span>
                    <div class="label">Motivo</div><span>@Kit.Motivo</span>
                </div>

                @foreach (var item in Items)
                {
                    <div class="kit-card">
                        <Separator></Separator>
                        <div class="kit-card__name">@item.Nombre</div>
                        <div class="kit-card__rows">
                            <div class="kit-card__row">
                                <div class="kit-card__pair">
                                    <div class="label">Talla</div>
                                    <div>@item.Talla</div>
                                </div>
                                <div class="kit-card__pair">
                                    <div class="label">Cantidad</div>
                                    <div>@item.Cantidad</div>
                                </div>
                            </div>

                            <div class="kit-card__row">
                                <div class="kit-card__pair">
                                    <div class="label">Precio (US)</div>
                                    <div>@item.PrecioUnitario</div>
                                </div>
                                <div class="kit-card__pair">
                                    <div class="label">Total (US)</div>
                                    <div>@item.Total</div>
                                </div>
                            </div>
                        </div>

                    </div>

                }
                <Separator></Separator>
                <div class="kit-detail__close">
                    <a class="latam-link-danger" @onclick="OnCloseClicked">Cerrar</a>
                </div>
            </div>

            


            <div class="kit-detail-desktop">
                    <div class="kit-detail__body">
                        <table class="kit-detail__table">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Talla</th>
                                    <th>Cantidad</th>
                                    <th>Precio (US)</th>
                                    <th>Total (US)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Items)
                                {
                                    <tr>
                                        <td>@item.Nombre</td>
                                        <td>@item.Talla</td>
                                        <td>@item.Cantidad</td>
                                        <td>@item.PrecioUnitario</td>
                                        <td>@item.Total</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="kit-detail__close">
                        <a class="latam-link-danger" @onclick="OnCloseClicked">
                            Cerrar
                        </a>
                    </div>
                </div>
        </div>
    </div>
}
@code {
        [Parameter] public EventCallback OnClosed { get; set; }
        [Parameter] public string Orden { get; set; } = string.Empty;
        [Parameter] public List<KitDetailModel> Items { get; set; } = new();
        [Parameter] public KitModel Kit { get; set; } = new();
        [Parameter] public bool Visible { get; set; }

    private void  OnCloseClicked()
    {
        OnClosed.InvokeAsync();
    }
   }