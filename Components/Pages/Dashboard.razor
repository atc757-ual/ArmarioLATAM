@page "/Dashboard"
@rendermode InteractiveServer

@using ArmarioLATAM.Components.Models
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Navigation


<section class="latam-section">
    <div class="title-dashboard">
        Kits
    </div>
    @if (errorSection)
    {
        <div class="latam-kit-wrapper full-width margin-top-base">
            <div class="latam-error-card">
                <div class="latam-error-header">
                    <img src="images/ico_bloqueo_accent.svg" alt="alert" class="" />
                    <span>No podemos cargar los kit</span>
                </div>
                <Separator></Separator>
                <div class="latam-error-body">
                    En estos momentos no es posible mostrar los kit de uniforme.<br />
                    Por favor, inténtalo nuevamente.
                </div>
                <Separator></Separator>
                <div class="latam-error-footer">
                    <button class="latam-btn latam-btn--primary" type="button" @onclick="Reintentar">
                        Reintentar
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        /* TAB MOBILE con botones */
        <div class="latam-kits-row">
            <div class="latam-kit-wrapper">
                <button class="latam-kit @(selectedTab == 1 ? "active" : "")"
                @onclick="() => SelectTab(1)">
                    @if (selectedTab == 1)
                    {
                        <img src="images/ico_new_blue.svg" alt="" />
                    }
                    else
                    {
                        <img src="images/ico_new.svg" alt="" />
                    }
                    <span class="latam-kit-label">Nuevo ingreso</span>
                </button>
                @* PANEL MÓVIL pegado al tab activo *@
                @if (selectedTab == 1)
                {

                    <div class="latam-kit-panel latam-kit-panel--mobile">
                        <table class="latam-kit-table latam-kit-table--details">
                            <tbody>

                                @if (isErrorNew)
                                {
                                    <tr class="latam-kit-table-empty">
                                        <td colspan="2">
                                            <img src="images/ico_bloqueo.svg" />
                                            <p>Ha ocurrido un problema al cargar el kit,<br />
                                                por favor vuelve a intentarlo.</p>
                                            <div class="margin-top-base">
                                                <button @onclick="ReintentarEmergency" type="button" class="latam-btn latam-btn--primary">Reintentar </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else if (isEmptyNew)
                                {
                                    <tr class="latam-kit-table-empty">
                                        <td colspan="2">
                                            <img src="images/ico_bag_cross.svg" />
                                            <p>Este Kit no esta disponible para ser solicitado.</p>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td>Código</td>
                                        <td>KIT2-l</td>
                                    </tr>
                                    <tr>
                                        <td>Nombre kit</td>
                                        <td>Apto Outdoor Unisex Inicial</td>
                                    </tr>
                                    <tr>
                                        <td>Orden</td>
                                        <td>Sin orden</td>
                                    </tr>
                                    <tr>
                                        <td>Fecha de creación</td>
                                        <td>12/12/2025</td>
                                    </tr>
                                    <tr>
                                        <td>Estado</td>
                                        <td>Pendiente</td>
                                    </tr>
                                    <tr class="separator">
                                    </tr>
                                    <tr class="latam-kit-table-footer">
                                        <td colspan="2">
                                            <button @onclick="GoNuevoIngreso" type="button" class="latam-btn latam-btn--primary">
                                                Solicitar uniforme
                                            </button>
                                        </td>
                                    </tr>


                                }

                            </tbody>
                        </table>
                    </div>

                }

            </div>
            <div class="latam-kit-wrapper">
                <button class="latam-kit @(selectedTab == 2 ? "active" : "")"
                @onclick="() => SelectTab(2)">
                    @if (selectedTab == 2)
                    {
                        <img src="images/ico_alert_blue.svg" alt="" />
                    }
                    else
                    {
                        <img src="images/ico_alert.svg" alt="" />
                    }
                    <span class="latam-kit-label">Solicitud de emergencia</span>
                </button>
                @if (selectedTab == 2)
                {
                    <div class="latam-kit-panel latam-kit-panel--mobile">
                        <table class="latam-kit-table latam-kit-table--details">
                            <tbody>
                                @if (isErrorEmergengy)
                                {
                                    <tr class="latam-kit-table-empty">
                                        <td colspan="2">
                                            <img src="images/ico_bloqueo.svg" />
                                            <p>
                                                Ha ocurrido un problema al cargar el kit,<br />
                                                por favor vuelve a intentarlo.
                                            </p>
                                            <div class="margin-top-base">
                                                <button @onclick="ReintentarEmergency" type="button" class="latam-btn latam-btn--primary">Reintentar </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else if (isEmptyEmergency)
                                {
                                    <tr class="latam-kit-table-empty">
                                        <td colspan="2">
                                            <img src="images/ico_bag_cross.svg" />
                                            <p>Este Kit no esta disponible para ser solicitado.</p>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td>Código</td>
                                        <td>KIT2-l</td>
                                    </tr>
                                    <tr>
                                        <td>Nombre kit</td>
                                        <td>Apto Outdoor Unisex Inicial</td>
                                    </tr>
                                    <tr>
                                        <td>Orden</td>
                                        <td>Sin orden</td>
                                    </tr>
                                    <tr>
                                        <td>Fecha de creación</td>
                                        <td>12/12/2025</td>
                                    </tr>
                                    <tr>
                                        <td>Estado</td>
                                        <td>Pendiente</td>
                                    </tr>
                                    <tr class="separator">
                                    </tr>
                                    <tr class="latam-kit-table-footer">
                                        <td colspan="2">
                                            <button @onclick="GoSolicitudEmergency" type="button" class="latam-btn latam-btn--primary">
                                                Solicitar uniforme
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
            <div class="latam-kit-wrapper">
                <button class="latam-kit @(selectedTab == 3 ? "active" : "")"
                @onclick="() => SelectTab(3)">
                    @if (selectedTab == 3)
                    {
                        <img src="images/ico_embarazo_blue.svg" alt="" />
                    }
                    else
                    {
                        <img src="images/ico_embarazo.svg" alt="" />
                    }
                    <span class="latam-kit-label">Solicitud de embarazo</span>
                </button>
                @if (selectedTab == 3)
                {
                    <div class="latam-kit-panel latam-kit-panel--mobile">
                        @* contenido tab 3 móvil *@
                    </div>
                }

            </div>
            <div class="latam-kit-wrapper">
                <button class="latam-kit @(selectedTab == 4 ? "active" : "")"
                @onclick="() => SelectTab(4)">
                    @if (selectedTab == 4)
                    {
                        <img src="images/ico_upgrade_blue.svg" alt="" />
                    }
                    else
                    {
                        <img src="images/ico_upgrade.svg" alt="" />
                    }
                    <span class="latam-kit-label">Kit de ascenso</span>
                </button>
                @if (selectedTab == 4)
                {
                    <div class="latam-kit-panel latam-kit-panel--mobile">
                        @* contenido tab 4 móvil *@
                    </div>
                }
            </div>
        </div>

        /* TAB DESKTOP con botones */
    <div class="latam-kit-panel latam-kit-panel--desktop">
        @if (selectedTab == 1)
        {
            <table class="latam-kit-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre kit</th>
                        <th>Orden</th>
                        <th>Fecha de creación</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                        @if (isErrorNew)
                        {
                            <tr class="latam-kit-table-empty">
                                <td colspan="5">
                                    <img src="images/ico_bloqueo.svg" />
                                    <p>
                                        Ha ocurrido un problema al cargar el kit,<br />
                                        por favor vuelve a intentarlo.
                                    </p>
                                    <div class="margin-top-base">
                                        <button @onclick="ReintentarEmergency" type="button" class="latam-btn latam-btn--primary">Reintentar </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if(isEmptyNew) 
                        {
                         <tr class="latam-kit-table-empty">
                            <td colspan="5">
                                <img src="images/ico_bag_cross.svg" />
                                <p>Este Kit no esta disponible para ser solicitado.</p>
                            </td>
                        </tr>
                           
                        }
                        else
                        {
                            <tr>
                                <td>KIT2-l</td>
                                <td>Apto-Outdoor--Unisex-Inicial</td>
                                <td>Sin orden</td>
                                <td><!-- fecha --></td>
                                <td>Pendiente</td>
                            </tr>
                            <tr class="latam-kit-table-footer">
                                <td colspan="5">
                                    <button type="button" @onclick="GoNuevoIngreso" class="latam-btn latam-btn--primary">
                                        Solicitar uniforme
                                    </button>
                                </td>
                            </tr>
                    }
                </tbody>
                </table>
            }
            else if (selectedTab == 2)
            {
                <table class="latam-kit-table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre kit</th>
                            <th>Orden</th>
                            <th>Fecha de creación</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isErrorEmergengy)
                        {
                            <tr class="latam-kit-table-empty">
                                <td colspan="5">
                                    <img src="images/ico_bloqueo.svg" />
                                    <p>
                                        Ha ocurrido un problema al cargar el kit,<br />
                                        por favor vuelve a intentarlo.
                                    </p>
                                    <div class="margin-top-base">
                                        <button @onclick="ReintentarEmergency" type="button" class="latam-btn latam-btn--primary">Reintentar </button>
                                    </div>
                                </td>
                            </tr>
                        }else if(isEmptyEmergency)
                        {
                            <tr class="latam-kit-table-empty">
                                <td colspan="5">
                                    <img src="images/ico_bag_cross.svg" />
                                    <p>Este Kit no esta disponible para ser solicitado.</p>
                                </td>
                            </tr>
                        }

                        else
                        {
                            <tr>
                                <td>KIT2-l</td>
                                <td>Apto-Outdoor--Unisex-Inicial</td>
                                <td>Sin orden</td>
                                <td><!-- fecha --></td>
                                <td>Pendiente</td>
                            </tr>
                            <tr class="latam-kit-table-footer">
                                <td colspan="5">
                                    <button type="button" @onclick="GoSolicitudEmergency" class="latam-btn latam-btn--primary">
                                        Solicitar uniforme
                                    </button>
                                </td>
                            </tr>
                        }
                </tbody>
            </table>
        }
        else if (selectedTab == 3)
        {
            @* contenido tab 3 desktop *@
        }
        else if (selectedTab == 4)
        {
            @* contenido tab 4 desktop *@
        }
    </div>
    }
    @if (!errorSection)
    {
        <ModalEmergency @ref="modalRef" @bind-IsOpenModal="IsOpenModal" />
    } 
   
</section>

@code {
    private bool errorSection = false;

    private bool isEmptyEmergency = false;
    private bool isErrorEmergengy = false;

    private bool isEmptyNew = false;
    private bool isErrorNew = false;

    private int selectedTab = 0;
    private void SelectTab(int tab) => selectedTab = tab;
    private bool IsOpenModal{ get; set; } = false;
    private ModalEmergency? modalRef;
    void GoNuevoIngreso()
    {
        Navigation.NavigateTo("/NuevoIngreso");
    }

    private async Task GoSolicitudEmergency()
    {
        if (modalRef is not null)
        {
            await modalRef.OpenAsync();
        }
        IsOpenModal = true;
    }
    private void ReintentarEmergency()
    {

    }
    private void Reintentar()
    {

    }
}
