@page "/NuevoIngresoResumen"
@using ArmarioLATAM.Services
@using ArmarioLATAM.Components.Models
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject GarmentSelectionState SelectionState
@rendermode InteractiveServer

<section class="latam-section">
    <div class="page-title">Nuevo ingreso</div>
    <Separator />
    <div class="nuevo-ingreso-header">
        <span class="label">Resumen de solicitud:</span><br class="mobile-break" /> <span class="label">Apto Outdoor Unisex</span>
    </div>

    <div class="summary-list">

        @foreach (var item in SelectionState.SelectedGarments)
        {
            <article class="summary-item">
                <img src="@item.ImageURL" class="summary-image" />
                <div class="summary-main">
                    <div class="summary-head">
                        <span class="summary-data-label">Name</span>
                        <span class="summary-data-value">@item.Name</span>
                    </div>
                    <div class="summary-data--mobile">
                        <span class="summary-data-label">Talla</span>
                        <span class="summary-data-value">@item.Size</span>
                        <span class="summary-data-label">Cantidad</span>
                        <span class="summary-data-value">@item.Quantity</span>
                    </div>
                </div>

                <div class="summary-data--desktop">
                    <div class="summary-size-block">
                        <span class="summary-data-label">Talla</span>
                        <span class="summary-data-value">@item.Size</span>
                    </div>
                    <div class="summary-qty-block">
                        <span class="summary-data-label">Cantidad</span>
                        <span class="summary-data-value">@item.Quantity</span>
                    </div>
                </div>
            </article>
        }

    </div>

    <Separator />
    <div class="redirects-footer">
        <button type="button"
                class="latam-back-link"
                @onclick="GoBack">
            <img src="images/ico_arrow_left.svg" />
            <span> Volver</span>
        </button>

        @if (isValid)
        {
            <div class="latam-btn-row">
                <button type="button" class="latam-btn latam-btn--primary " @onclick="GoNext">Confirmar solicitud</button>
            </div>
        }
        else
        {
            <div class="latam-btn-row">
                <button type="button" class="latam-btn latam-btn--primary " disabled>
                    Confirmar solicitud
                </button>
            </div>
        }
    </div>
</section>
@code {


    private bool isValid = true;
    void GoBack()
    {
        JS.InvokeVoidAsync("history.back");
    }

    void GoNext()
    {
        Navigation.NavigateTo("/NuevoIngresoComprobante");
    }

}
