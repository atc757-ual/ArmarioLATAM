@page "/ResetPassword"
@using System.Web
@using ArmarioLATAM.Components.Models
@using ArmarioLATAM.Services
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@using System.ComponentModel.DataAnnotations
@rendermode InteractiveServer

<div class="latam-login-wrapper">
    <div class="latam-login-card">
        <img src="images/logo_footer.svg" alt="LATAM" class="latam-login-logo" />
        <div class="latam-login-title">Recuperar contraseña</div>

        @if (IsSubmited && IsSuccess)
        {

            <div class="fs-16  text-center fw-normal">
                <p class="fw-normal">
                    Tu contraseña se ha actualizado con éxito, <br />
                    vuelve al inicio para acceder con tu email y clave a ArmarioLATAM.
                </p>
            </div>
            <div class="latam-btn-row">
                <button type="buttom" class=" latam-btn latam-btn--primary" @onclick="Inicio">
                    Iniciar Sesión
                </button>
            </div>
        }
        else
        {
            if (MostrarToast)
            {
                <Toast Visible="@MostrarToast" Title="Error" Message="El enlace es inválido o ha expirado." Type="error" OnClosed="@ToastCerrado" />
            }
            <EditForm FormName="loginForm"
                      Model="@changePassword"
                      OnValidSubmit="@OnSubmit">
                <DataAnnotationsValidator />
                <div class="latam-field">
                    <label for="contrasena">Contraseña</label>
                    <div class="latam-password-wrapper">
                        <InputText id="contrasena"
                                   name="Contrasena"
                                   type="@(showPassword ? "text" : "password")"
                                   maxlength="50"
                                   class="latam-input"
                                   @onblur="OnPasswordBlur"
                                   @bind-Value="changePassword.Password"
                                   placeholder="Ingresa tu contraseña"
                                   disabled="@isLoading" />
                        <button type="button"
                                @onclick="TogglePasswordVisibility"
                                class="latam-password-toggle"
                                tabindex="-1">
                            @if (showPassword)
                            {
                                <img src="images/ico_eye_show.svg" alt="Ocultar" />
                            }
                            else
                            {
                                <img src="images/ico_eye_hide.svg" alt="Mostrar" />
                            }
                        </button>
                    </div>
                    <ValidationMessage For="@(() => changePassword.PasswordConfirm)" />
                </div>
                <div class="latam-field">
                    <label for="contrasenaConfirm">Contraseña</label>
                    <div class="latam-password-wrapper">
                        <InputText id="contrasenaConfirm"
                                   name="contrasenaConfirm"
                                   type="@(showPasswordConfirm ? "text" : "password")"
                                   maxlength="50"
                                   class="latam-input"
                                   @onblur="OnPasswordConfirmBlur"
                                   @bind-Value="changePassword.PasswordConfirm"
                                   placeholder="Ingresa tu contraseña"
                                   disabled="@isLoading" />
                        <button type="button"
                                @onclick="TogglePasswordConfirmVisibility"
                                class="latam-password-toggle"
                                tabindex="-1">
                            @if (showPasswordConfirm)
                            {
                                <img src="images/ico_eye_show.svg" alt="Ocultar" />
                            }
                            else
                            {
                                <img src="images/ico_eye_hide.svg" alt="Mostrar" />
                            }
                        </button>
                    </div>
                    <ValidationMessage For="@(() => changePassword.PasswordConfirm)" />
                </div>
                @if (isValidPassword && isValidPasswordConfirm)
                {
                    <div class="latam-btn-row">
                        <button type="submit"
                                class="latam-btn latam-btn--primary"
                                disabled="@isLoading">
                            @(isLoading ? "Verificando..." : "Ingresar")
                        </button>
                    </div>
                }
                else
                {
                    <div class="latam-btn-row">
                        <button disabled type="button" class="latam-btn latam-btn--primary">
                            Ingresar
                        </button>
                    </div>
                }
            </EditForm>
        }
    </div>
</div>

@code {
    private ChangePassword changePassword = new();
    private bool showPassword = false;
    private bool showPasswordConfirm = false;
    private bool isLoading = false;
    private bool isValidPassword = false;
    private bool isValidPasswordConfirm = false;
    private bool IsSuccess = false;
    private bool IsSubmited = false;
    private bool MostrarToast = false;


    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }
    private void TogglePasswordConfirmVisibility()
    {
        showPasswordConfirm = !showPasswordConfirm;
    }
    private void Inicio()
    {
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
    private async Task OnSubmit()
    {
        isLoading = true;

        var ok = await AuthService.ResetPasswordAsync(changePassword.Token, changePassword.PasswordConfirm);
        if (ok)
        {
            IsSuccess = true;
        }
        else
        {
            MostrarToast = true;
        }
        isLoading = false;
        IsSubmited = true;
    }
    protected override void OnInitialized()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        var token = query["token"];

        if (!string.IsNullOrEmpty(token))
        {
            changePassword.Token = token;
        }
        else
        {
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
    }
    private void ToastCerrado()
    {
        MostrarToast = false;
    }

    private void OnPasswordBlur(FocusEventArgs e)
    {
        var results = new List<ValidationResult>();
        var context = new ValidationContext(changePassword)
        {
            MemberName = nameof(ChangePassword.Password)
        };

        isValidPassword = Validator.TryValidateProperty(
            changePassword.Password,
            context,
            results);

        StateHasChanged();
    }
    private void OnPasswordConfirmBlur(FocusEventArgs e)
    {
        var results = new List<ValidationResult>();
        var context = new ValidationContext(changePassword)
        {
            MemberName = nameof(ChangePassword.PasswordConfirm)
        };

        isValidPasswordConfirm = Validator.TryValidateProperty(
            changePassword.PasswordConfirm,
            context,
            results);

        StateHasChanged();
    }
}