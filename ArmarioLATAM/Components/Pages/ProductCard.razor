@using ArmarioLATAM.Components.Models
@using ArmarioLATAM.Services
@inject GarmentSelectionState GarmentSelectionState
@rendermode InteractiveServer

<div class="garment-card">
    <img src="@garments.ImageURL" alt="@garments.Name" class="garment-image" />

    <div class="garment-content">
        <h3 class="garment-title">@garments.Name</h3>
        <p class="garment-subtitle">
            Cantidad autorizada para esta prenda: @garments.QuantityAuth
        </p>

        <div class="garment-qty">
            <span>Cantidad</span>
            <div class="garment-qty-controls ">
                @if (Quantity == 0 )
                {
                    <button type="button">
                        <img src="images/ico_minus.svg" />
                    </button>
                }
                else
                {
                    <button type="button" @onclick="Decrement">
                        <img src="images/ico_minus_blue.svg" />
                    </button>
                }
                <span class="garment-qty-count">@Quantity</span>
                @if(garments.QuantityAuth > Quantity)
                {
                    <button type="button" @onclick="Increment">
                        <img src="images/ico_add_blue.svg" />
                    </button>
                }
                else
                {
                    <button type="button">
                        <img src="images/ico_add.svg" />
                    </button>
                }

            </div>
        </div>
        @if (garments.Languages == "")
        {
            <div class="garment-languages">
                <DropdownSelect Id="native" Placeholder="Lengua materna"
                                Options="LanguageOptions"
                                @bind-OpenId="openSelectId"
                                @bind-Value="NativeLanguage" />

                <DropdownSelect Id="second" Placeholder="Idioma 2"
                                Options="LanguageOptions"
                                @bind-OpenId="openSelectId"
                                @bind-Value="SecondLanguage" />

                <DropdownSelect Id="third" Placeholder="Idioma 3"
                                Options="LanguageOptions"
                                @bind-OpenId="openSelectId"
                                @bind-Value="ThirdLanguage" />
            </div>
        }
        else
        {
            <div class="garment-sizes" >
                <span>Selecciona tu talla</span>
                <div class="garment-size-grid">
                    @foreach (var size in garments.SizeList)
                    {
                        if(Quantity > 0)
                        {
                            <button type="button" 
                                class="garment-size @(SelectedSize == size ? "is-selected" : "")"
                                    @onclick="() => SelectSize(size)">
                                @size
                            </button>
                        }
                        else
                        {
                            <button type="button" 
                                class="garment-size garment-size--disable" disabled>
                                @size
                            </button>
                        }
                    }
                </div>
            </div>

        }

        
        @if (garments.Languages == "")
        {
            <div class="garment-language-note">
               <ul>
                    <li>Afirmo que hablo fluidamente los idiomas seleccionados y que poseo un Certificado que lo avala. En caso de no poseer certificado, la empresa podrá aplicar sanciones.</li>
               </ul> 
            </div>
        }else{
             <p class= "garment-note" >
                Considera las indicaciones del <span class="text-accent">Manual de Uniformidad</span> al seleccionar la talla.
            </p>
        }
    </div>

    

</div>

@code {
    [Parameter] public Garment garments { get; set; } = new Garment();
    [Parameter] public int InitialQuantity { get; set; }
    [Parameter] public string? InitialSize { get; set; }
    [Parameter] public EventCallback<GarmentSelection> OnChanged { get; set; }
    public int Quantity { get; set; } = 0;
    public string? SelectedSize { get; set; }
    string? openSelectId; 
    // idiomas disponibles para los combos
    public List<string> LanguageOptions { get; set; } = new() { "Español", "Inglés", "Portugués" };

    public string? NativeLanguage { get; set; }
    public string? SecondLanguage { get; set; }
    public string? ThirdLanguage { get; set; }

    
    async Task Increment()
    {
        if (Quantity < garments.QuantityAuth)
            Quantity++;
        await NotifyParent();
    }

    async Task Decrement()
    {
        if (Quantity >= 1)
            Quantity--;
        await NotifyParent();
    }

    async Task SelectSize(string size)
    {
        SelectedSize = size;
        await NotifyParent();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Quantity == 0 && SelectedSize == null)
        {
            Quantity = InitialQuantity;
            SelectedSize = InitialSize;

            if (Quantity > 0 || !string.IsNullOrEmpty(SelectedSize))
            {
                await NotifyParent();
            }
        }
    }
    async Task NotifyParent()
    {
        if (!OnChanged.HasDelegate) return;

        var data = new GarmentSelection
        {
            GarmentId = garments.GarmentId,
            Name = garments.Name,
            Quantity = Quantity,
            Size = SelectedSize,
            ImageURL = garments.ImageURL,
        };

        await OnChanged.InvokeAsync(data);
    }
}
