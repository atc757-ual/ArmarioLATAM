@page "/ForgotPassword"
@rendermode InteractiveServer
@using ArmarioLATAM.Components.Models
@using System.ComponentModel.DataAnnotations
@inject NavigationManager NavigationManager
@using ArmarioLATAM.Services
@inject IAuthService AuthService

<div class="latam-login-wrapper">
    <div class="latam-login-card">
        <img src="images/logo_footer.svg" alt="LATAM" class="latam-login-logo" />
        <div class="latam-login-title">Recuperar contraseña</div>
        @if (isSubmitted && isSuccess)
        {
            <div class="fs-16  text-center fw-normal">
                <p class="fw-normal">

                    Hemos enviado un correo a <b>@loginModel.Correo</b> con instrucciones <br />
                    para que puedas cambiar tu contraseña y acceder a Armario LATAM.
                </p>
            </div>
            <div class="latam-btn-row">
                <button type="submit" class=" latam-btn latam-btn--primary" @onclick="Inicio">
                    Volver a inicio de sesión
                </button>
            </div>
        }
        else if (isSubmitted && !isSuccess)
        {
            <div class="fs-16  text-center fw-normal">
                <p class="fw-normal">
                    En estos momentos no podemos recuperar tu contraseña.<br />
                    Por favor, vuelve a intentarlo más tarde.
                </p>
            </div>
            <div class="latam-btn-row">
                <button type="button" class=" latam-btn latam-btn--primary" @onclick="Inicio">
                    Volver a inicio de sesión
                </button>
            </div>
        }
        else
        {
            <div>
                <p class="fs-16 fw-normal text-center">
                    Ingresa el correo asociado a tu cuenta.<br />
                    Te enviaremos un correo con instrucciones para recuperar tu contraseña para que puedas ingresar.
                </p>
            </div>
            <EditForm FormName="loginForm" Model="@loginModel" OnValidSubmit="@OnSubmit">
                <DataAnnotationsValidator />
                <div class="latam-field">
                    <label for="correo">Correo</label>
                    <InputText id="correo"
                               name="Correo"
                               class="latam-input"
                               @bind-Value="loginModel.Correo"
                               @onblur="OnCorreoBlur"
                               placeholder="Ingresa tu correo"></InputText>
                    <ValidationMessage For="@(() => loginModel.Correo)" />
                </div>
                <div class="latam-btn-row">
                    <button class="latam-btn latam-btn--primary" type="submit" disabled="@isLoading">
                        @((isLoading ? "Enviando..." : "Enviar enlace"))
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(message))
                {
                    <p>@message</p>
                }
            </EditForm>
            <button type="button"
                    class="latam-back-link"
                    @onclick="Inicio">
                <img src="images/ico_arrow_left.svg" />
                <span> Volver</span>
            </button>
        }

    </div>
</div>

@code {
    private LoginModelOnlyPassword loginModel = new();
    private bool isLoading;
    private string? message;
    private bool isSubmitted = false;
    private bool isSuccess = false;


    void Inicio()
    {
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
    private async Task OnSubmit()
    {
        isLoading = true;
        message = null;
        await Task.Delay(1000);
        var ok = await AuthService.SendResetEmailAsync(loginModel.Correo);
        isSuccess = ok;
        isSubmitted = true;
        isLoading = false;
    }

    private bool isValidEmail;

    private void OnCorreoBlur(FocusEventArgs e)
    {
        // valida SOLO la propiedad Correo con DataAnnotations
        var results = new List<ValidationResult>();
        var context = new ValidationContext(loginModel)
        {
            MemberName = nameof(loginModel.Correo)
        };

        isValidEmail = Validator.TryValidateProperty(
            loginModel.Correo,
            context,
            results);

        StateHasChanged();
    }
}