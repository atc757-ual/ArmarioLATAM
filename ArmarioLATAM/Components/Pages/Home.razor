@page "/"
@rendermode InteractiveServer
@using ArmarioLATAM.Components.Models
@using ArmarioLATAM.Services
@using System.ComponentModel.DataAnnotations
@inject ProtectedLocalStorageService ProtectedLocalStorage
@inject NavigationManager NavigationManager
@inject IAuthService AuthService

<div class="latam-login-wrapper">
    <div class="latam-login-card">

        <img src="images/logo_footer.svg" alt="LATAM" class="latam-login-logo" />
        <h1 class="latam-login-title">Ingresar</h1>

        @* Mensaje de error *@
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="background-color:#fee;border:1px solid #fcc;color:#c33;
                                padding:10px;margin-bottom:15px;border-radius:4px;">
                @errorMessage
            </div>
        }

        <EditForm FormName="loginForm"
                  Model="@loginModel"
                  OnValidSubmit="@OnSubmit">
            <DataAnnotationsValidator />

            <div class="latam-field">
                <label for="correo">Correo</label>
                <InputText id="correo"
                           name="Correo"
                           class="latam-input"
                           @bind-Value="loginModel.Correo"
                           @onblur="OnCorreoBlur"
                           placeholder="Ingresa tu correo"
                           disabled="@isLoading" />
                <ValidationMessage For="@(() => loginModel.Correo)" />
            </div>

            <div class="latam-field">
                <label for="contrasena">Contraseña</label>
                <InputText id="contrasena"
                           name="Contrasena"
                           type="password"
                           maxlength="50"
                           class="latam-input"
                           @bind-Value="loginModel.Contrasena"
                           @onblur="OnContrasenaBlur"
                           placeholder="Ingresa tu contraseña"
                           disabled="@isLoading" />
                <ValidationMessage For="@(() => loginModel.Contrasena)" />
            </div>

            <div class="latam-remember-row">
                <InputCheckbox id="recordarme"
                               class="latam-checkbox"
                               @bind-Value="loginModel.Recordarme"
                               disabled="@isLoading" />
                <label for="recordarme">¿Recordarme?</label>
            </div>

            @if (isValidCorreo && isValidContrasena)
            {
                <div class="latam-btn-row">
                    <button type="submit"
                            class="latam-btn latam-btn--primary"
                            disabled="@isLoading">
                        @(isLoading ? "Verificando..." : "Ingresar")
                    </button>
                </div>
            }
            else
            {
                <div class="latam-btn-row">
                    <button disabled type="button" class="latam-btn latam-btn--primary">
                        Ingresar
                    </button>
                </div>
            }

        </EditForm>
    </div>

    <div class="latam-login-links">
        <a href="/ResetPassword" class="latam-link-danger">
            ¿Olvidaste tu contraseña?
        </a>
    </div>
</div>

<ClearLocalData />
@code {
    private LoginModel loginModel = new();
    private bool isValidCorreo;
    private bool isValidContrasena;
    private bool isLoading;
    private string errorMessage = string.Empty;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && isValidContrasena && isValidCorreo)
        {
           await OnSubmit();
        }
    }

    private async Task OnSubmit()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            await Task.Delay(500); // Simula tiempo de espera
            var response = await AuthService.LoginAsync(
                loginModel.Correo,
                loginModel.Contrasena);

            if (response != null && !string.IsNullOrEmpty(response.Token))
            {
                if (loginModel.Recordarme)
                {
                    await ProtectedLocalStorage.SetItemAsync("remember", loginModel.Correo);
                }
                else
                {
                    await ProtectedLocalStorage.RemoveItemAsync("remember");
                }
                NavigationManager.NavigateTo("/Dashboard");
            }
            else
            {
                isLoading = false;
                errorMessage = "Credenciales inválidas. Verifica tu correo y contraseña.";
            }
        }
        catch (Exception ex)
        {
            isLoading = false;
            errorMessage = "Error al conectar con el servidor.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void OnCorreoBlur(FocusEventArgs e)
    {
        var results = new List<ValidationResult>();
        var context = new ValidationContext(loginModel)
        {
            MemberName = nameof(LoginModel.Correo)
        };

        isValidCorreo = Validator.TryValidateProperty(
            loginModel.Correo,
            context,
            results);

        StateHasChanged();
    }

    private void OnContrasenaBlur(FocusEventArgs e)
    {
        var results = new List<ValidationResult>();
        var context = new ValidationContext(loginModel)
        {
            MemberName = nameof(LoginModel.Contrasena)
        };

        isValidContrasena = Validator.TryValidateProperty(
            loginModel.Contrasena,
            context,
            results);

        StateHasChanged();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return; // solo ejecuta en el primer render

        var savedEmail = await ProtectedLocalStorage.GetItemAsync<string>("remember");
        if (!string.IsNullOrEmpty(savedEmail))
        {
            loginModel.Correo = savedEmail;
            loginModel.Recordarme = true;

            // Valida el email cargado
            OnCorreoBlur(new FocusEventArgs());
        }
    }
}

