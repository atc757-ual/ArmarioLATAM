@page "/Dashboard"
@rendermode InteractiveServer
@using ArmarioLATAM.Components.Models
@using System.ComponentModel.DataAnnotations
@using ArmarioLATAM.Services
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject IKitService KitService
@inject KitSelectionState KitSelectionState
 

@if (!isLoaded)
{
    <LoadPage></LoadPage>
}
else
{
<section class="latam-section">
    <div class="title-dashboard">Kits</div>
       
    <!--
       <div class="latam-kit-wrapper full-width margin-top-base">
            <div class="latam-error-card">
                <div class="latam-error-header">
                    <img src="images/ico_bloqueo_accent.svg" alt="alert" class="" />
                    <span>No podemos cargar los kit</span>
                </div>
                <Separator></Separator>
                <div class="latam-error-body">
                    En estos momentos no es posible mostrar los kit de uniforme.<br />
                    Por favor, inténtalo nuevamente.
                </div>
                <Separator></Separator>
                <div class="latam-error-footer">
                    <button class="latam-btn latam-btn--primary" type="button" @onclick="Reintentar">
                        Reintentar
                    </button>
                </div>
            </div>
        </div>
    -->
    @if (_kitTypes is not null && _kitTypes.Any())
        {
            <div class="latam-kits-row">
                @foreach (var kit in _kitTypes!)
                {

                    <div class="latam-kit-wrapper">
                        <button class="latam-kit @(kit.KitTypeId == selectedTab ? "active" : "")"
                                @onclick="() => SelectTab(kit.KitTypeId)">
                            @if (kit.KitTypeId == selectedTab)
                            {
                                <img src="@kit.ImageURLSelect" alt="" />
                            }
                            else
                            {
                                <img src="@kit.ImageURL" alt="" />
                            }
                            <span class="latam-kit-label">@kit.Name</span>
                        </button>
                        <!-- TAB Mobile con botones -->
                        @if (selectedTab == kit.KitTypeId && kit.KitTypeId == 1)
                        {
                           <div class="latam-kit-panel latam-kit-panel--mobile">
                                <table class="latam-kit-table latam-kit-table--details">
                                    <tbody>
                                        @if (isError)
                                        {
                                            <tr class="latam-kit-table-empty">
                                                <td colspan="2">
                                                    <img src="images/ico_bloqueo.svg" />
                                                    <p>
                                                        Ha ocurrido un problema al cargar el kit,<br />
                                                        por favor vuelve a intentarlo.
                                                    </p>
                                                    <div class="margin-top-base">
                                                        <button @onclick="ReintentarEmergency" type="button" class="latam-btn latam-btn--primary">Reintentar </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        else if (isEmpty)
                                        {
                                            <tr class="latam-kit-table-empty">
                                                <td colspan="2">
                                                    <img src="images/ico_bag_cross.svg" />
                                                    <p>Este Kit no esta disponible para ser solicitado.</p>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td>Código</td>
                                                <td>KIT2-l</td>
                                            </tr>
                                            <tr>
                                                <td>Nombre kit</td>
                                                <td>Apto Outdoor Unisex Inicial</td>
                                            </tr>
                                            <tr>
                                                <td>Orden</td>
                                                <td>Sin orden</td>
                                            </tr>
                                            <tr>
                                                <td>Fecha de creación</td>
                                                <td>12/12/2025</td>
                                            </tr>
                                            <tr>
                                                <td>Estado</td>
                                                <td>Pendiente</td>
                                            </tr>
                                            <tr class="separator">
                                            </tr>
                                            <tr class="latam-kit-table-footer">
                                                <td colspan="2">
                                                    <button @onclick="() => GoNuevoIngreso(kit)" type="button" class="latam-btn latam-btn--primary">
                                                        Solicitar uniforme
                                                    </button>
                                                </td>
                                            </tr>
                                        }

                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (selectedTab == kit.KitTypeId && kit.KitTypeId == 2)
                        {
                            <div class="latam-kit-panel latam-kit-panel--mobile">
                                <table class="latam-kit-table latam-kit-table--details">
                                    <tbody>
                                        @if (isError)
                                        {
                                            <tr class="latam-kit-table-empty">
                                                <td colspan="2">
                                                    <img src="images/ico_bloqueo.svg" />
                                                    <p>
                                                        Ha ocurrido un problema al cargar el kit,<br />
                                                        por favor vuelve a intentarlo.
                                                    </p>
                                                    <div class="margin-top-base">
                                                        <button @onclick="ReintentarEmergency" type="button" class="latam-btn latam-btn--primary">Reintentar </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        else if (isEmpty)
                                        {
                                            <tr class="latam-kit-table-empty">
                                                <td colspan="2">
                                                    <img src="images/ico_bag_cross.svg" />
                                                    <p>Este Kit no esta disponible para ser solicitado.</p>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td>Código</td>
                                                <td>KIT2-l</td>
                                            </tr>
                                            <tr>
                                                <td>Nombre kit</td>
                                                <td>Apto Outdoor Unisex Inicial</td>
                                            </tr>
                                            <tr>
                                                <td>Orden</td>
                                                <td>Sin orden</td>
                                            </tr>
                                            <tr>
                                                <td>Fecha de creación</td>
                                                <td>12/12/2025</td>
                                            </tr>
                                            <tr>
                                                <td>Estado</td>
                                                <td>Pendiente</td>
                                            </tr>
                                            <tr class="separator">
                                            </tr>
                                            <tr class="latam-kit-table-footer">
                                                <td colspan="2">
                                                    <button @onclick="GoSolicitudEmergency" type="button" class="latam-btn latam-btn--primary">
                                                        Solicitar uniforme
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (selectedTab == kit.KitTypeId && kit.KitTypeId == 3)
                        {
                            @* contenido tab 3 mobile *@
                        }
                        @if(selectedTab == kit.KitTypeId && kit.KitTypeId == 4)
                                {
                            @* contenido tab 4 mobile *@
                        }
                    </div>

                }     
            
            </div> 
            <!--TAB DESKTOP con botones-->
            <div class="latam-kit-panel latam-kit-panel--desktop">
                    @if (selectedTab == 1)
                    {
                        <table class="latam-kit-table">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Nombre kit</th>
                                    <th>Orden</th>
                                    <th>Fecha de creación</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (isError)
                                {
                                    <tr class="latam-kit-table-empty">
                                        <td colspan="5">
                                            <img src="images/ico_bloqueo.svg" />
                                            <p>
                                                Ha ocurrido un problema al cargar el kit,<br />
                                                por favor vuelve a intentarlo.
                                            </p>
                                            <div class="margin-top-base">
                                                <button @onclick="ReintentarEmergency" type="button" class="latam-btn latam-btn--primary">Reintentar </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else if (isEmpty)
                                {
                                    <tr class="latam-kit-table-empty">
                                        <td colspan="5">
                                            <img src="images/ico_bag_cross.svg" />
                                            <p>Este Kit no esta disponible para ser solicitado.</p>
                                        </td>
                                    </tr>

                                }
                                else
                                {
                                    <tr>
                                        <td>KIT2-l</td>
                                        <td>Apto-Outdoor--Unisex-Inicial</td>
                                        <td>Sin orden</td>
                                        <td><!-- fecha --></td>
                                        <td>Pendiente</td>
                                    </tr>
                                    <tr class="latam-kit-table-footer">
                                        <td colspan="5">
                                            <button type="button" @onclick="GoNuevoIngresoDesktop" class="latam-btn latam-btn--primary">
                                                Solicitar uniforme
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    @if (selectedTab == 2)
                    {
                        <table class="latam-kit-table">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Nombre kit</th>
                                    <th>Orden</th>
                                    <th>Fecha de creación</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (isError)
                                {
                                    <tr class="latam-kit-table-empty">
                                        <td colspan="5">
                                            <img src="images/ico_bloqueo.svg" />
                                            <p>
                                                Ha ocurrido un problema al cargar el kit,<br />
                                                por favor vuelve a intentarlo.
                                            </p>
                                            <div class="margin-top-base">
                                                <button @onclick="ReintentarEmergency" type="button" class="latam-btn latam-btn--primary">Reintentar </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else if (isEmpty)
                                {
                                    <tr class="latam-kit-table-empty">
                                        <td colspan="5">
                                            <img src="images/ico_bag_cross.svg" />
                                            <p>Este Kit no esta disponible para ser solicitado.</p>
                                        </td>
                                    </tr>
                                }

                                else
                                {
                                    <tr>
                                        <td>KIT2-l</td>
                                        <td>Apto-Outdoor--Unisex-Inicial</td>
                                        <td>Sin orden</td>
                                        <td><!-- fecha --></td>
                                        <td>Pendiente</td>
                                    </tr>
                                    <tr class="latam-kit-table-footer">
                                        <td colspan="5">
                                            <button type="button" @onclick="GoSolicitudEmergency" class="latam-btn latam-btn--primary">
                                                Solicitar uniforme
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    @if (selectedTab == 3)
                    {
                        @* contenido tab 3 desktop *@
                    }

                    @if (selectedTab == 4)
                    {
                        @* contenido tab 4 desktop *@
                    }

                </div>
        }

    @if (IsOpenModal)
    {
        <ModalEmergency @ref="modalRef" @bind-IsOpenModal="IsOpenModal" />
    }

</section>
}

<ValidaSession />
@code {
    private bool isEmpty = false;
    private bool isError = false;
    private int selectedTab = 0;
    private bool IsOpenModal { get; set; } = false;
    private ModalEmergency? modalRef;


    private void SelectTab(int tab) => selectedTab = tab;

    void GoNuevoIngreso(KitType kit)
    {
        KitSelectionState.Set(kit);
        Navigation.NavigateTo("/NuevoIngreso");
    }

    void GoNuevoIngresoDesktop()
    {
        var kit = _kitTypes?.FirstOrDefault(k => k.KitTypeId == selectedTab);
        if (kit is null)
            return; 

        KitSelectionState.Set(kit);
        Navigation.NavigateTo("/NuevoIngreso");
    }

    private async Task GoSolicitudEmergency()
    {
        if (modalRef is not null)
        {
            await modalRef.OpenAsync();
        }
        IsOpenModal = true;
    }

    private void ReintentarEmergency()
    {

    }
    private void Reintentar()
    {

    }

    private List<KitType>? _kitTypes;
    private bool isLoaded = false;

    protected override async Task OnInitializedAsync()
    { 
            await Task.Delay(500);
            try
            {
                _kitTypes = await KitService.GetKitTypesAsync();
                isEmpty = _kitTypes == null || !_kitTypes.Any();
            }
            catch
            {
                isError = true;
            }
            finally
            {
                isLoaded = true;
            }
        }
}
