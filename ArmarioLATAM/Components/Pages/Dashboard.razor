@page "/Dashboard"
@rendermode InteractiveServer

<!------------------------------------------------------------------------------------->
<!-- 🏠 DASHBOARD PRINCIPAL - SELECCIÓN DE KITS + HISTORIAL -->
<!------------------------------------------------------------------------------------->
@using ArmarioLATAM.Components.Models
@using ArmarioLATAM.Services
@inject NavigationManager Navigation
@inject IKitService KitService
@inject IOrderService OrderService
@inject IAuthService AuthService
@inject DetailDeliveredState DetailDeliveredState
@inject ProtectedLocalStorageService LocalStorage
@inject KitSelectionState KitSelectionState

<!------------------------------------------------------------------------------------->
<!-- 🔄 FASE DE CARGA INICIAL (LOADING + CLEANUP) -->
<!------------------------------------------------------------------------------------->
@if (!isLoaded)
{
    <LoadPage></LoadPage>
    <ClearLocalData></ClearLocalData>
}
else
{
    <!------------------------------------------------------------------------------------->
    <!-- 📱 SECCIÓN PRINCIPAL - KITS DISPONIBLES (MÓVIL) -->
    <!------------------------------------------------------------------------------------->
    <section class="latam-section">
        
        @if (_kitTypes is not null && _kitTypes.Any())
        {
            <!-- 🎯 TÍTULO KITS -->
            <div class="title-dashboard">Kits</div>
            
            <!-- 📱 ROW DE KITS (MÓVIL) -->
            <div class="latam-kits-row">
                @foreach (var kit in _kitTypes!)
                {
                    <!-- 🆔 KIT 1: BÁSICO (menos de 1 mes) -->
                    @if (kit.KitTypeId == 1 && menosDeUnMes)
                    {
                        <KitCardMobile Kit="@kit" 
                                       IsSelected="@(selectedTab == kit.KitTypeId)"
                                       PendingOrder="@pendingOrder"
                                       OnSelectKit="() => SelectTab(kit.KitTypeId)"
                                       OnGoGarments="() => GoGarments(kit)" />
                    }
                    <!-- 🆔 KIT 2: ESTÁNDAR (siempre disponible) -->
                    else if (kit.KitTypeId == 2)
                    {
                        <KitCardMobile Kit="@kit" 
                                       IsSelected="@(selectedTab == kit.KitTypeId)"
                                       PendingOrder="@pendingOrder"
                                       OnSelectKit="() => SelectTab(kit.KitTypeId)"
                                       OnGoGarments="() => GoGarments(kit)" />
                    }
                    <!-- 👩 KIT 3: MUJER (solo si es mujer) -->
                    else if (kit.KitTypeId == 3 && esMujer)
                    {
                        <KitCardMobile Kit="@kit" 
                                       IsSelected="@(selectedTab == kit.KitTypeId)"
                                       PendingOrder="@pendingOrder"
                                       IsError="@isError"
                                       OnSelectKit="() => SelectTab(kit.KitTypeId)"
                                       OnGoGarments="() => GoGarments(kit)" />
                    }
                    <!-- 🆔 KIT 4: 2+ AÑOS (más de 2 años antigüedad) -->
                    else if (kit.KitTypeId == 4 && masDeDosAnios)
                    {
                        <KitCardMobile Kit="@kit" 
                                       IsSelected="@(selectedTab == kit.KitTypeId)"
                                       PendingOrder="@pendingOrder"
                                       OnSelectKit="() => SelectTab(kit.KitTypeId)"
                                       OnGoGarments="() => GoGarments(kit)" />
                    }
                    <!-- 🆔 KIT 5: 1+ AÑO (más de 1 año antigüedad) -->
                    else if (kit.KitTypeId == 5 && masDeUnAnio)
                    {
                        <KitCardMobile Kit="@kit" 
                                       IsSelected="@(selectedTab == kit.KitTypeId)"
                                       PendingOrder="@pendingOrder"
                                       OnSelectKit="() => SelectTab(kit.KitTypeId)"
                                       OnGoGarments="() => GoGarments(kit)" />
                    }
                }
            </div>

            <!-- 💻 PANEL DESKTOP - TABLA PENDIENTE -->
            <div class="latam-kit-panel--desktop">
                @if (selectedTab > 0)
                {
                    <PendingOrderTableDesktop 
                        PendingOrder="@pendingOrder"
                        SelectedTab="@selectedTab"
                        OnGoGarments="GoGarmentsDesktop" />
                }
            </div>

            <!-- 📜 CARD HISTORIAL DE SOLICITUDES -->
            <div class="card-history">
                <div class="card-history-title">Historial de solicitudes de kits</div>
                
                <!-- 💻 HISTORIAL DESKTOP -->
                <div class="latam-kit-panel--desktop no-shadow">
                    <HistoryTableDesktop Orders="@historycOrders" 
                                        OnSeguimiento="Seguimiento" />
                </div>
                
                <!-- 📱 HISTORIAL MÓVIL -->
                <div class="latam-kit-panel--mobile no-shadow">
                    <HistoryTableMobile Orders="@historycOrders" 
                                       OnSeguimiento="Seguimiento" />
                </div>
                
                <!-- 📄 PAGINACIÓN DESKTOP -->
                @if (historycOrders is not null && historycOrders.Count > pageSizeDesktop)
                {
                    <PaginationDesktop CurrentPage="@currentPageDesktop"
                                     TotalPages="@TotalPagesDesktop"
                                     OnNext="NextDesktop"
                                     OnPrev="PrevDesktop" />
                }
            </div>
        }

        <!-- 🪟 MODAL GARMENTS (solo kit 2) -->
        <GarmentsModal @ref="modalRef" />
    </section>
}

<!-- 🔐 VALIDADOR DE SESIÓN -->
<ValidaSession />

<!------------------------------------------------------------------------------------->
<!-- 🎮 LÓGICA DEL COMPONENTE - SECCIÓN CÓDIGO -->
<!------------------------------------------------------------------------------------->
@code {
    // ============================================================================
    // 1) 🛠️ ESTADOS BÁSICOS DE LA PÁGINA
    // ============================================================================
    private bool isEmpty = false;
    private bool isError = false;
    private bool isLoaded = false;
    private int selectedTab = 0;

    // ============================================================================
    // 2) 📊 DATOS PRINCIPALES
    // ============================================================================
    private GarmentsModal? modalRef;
    private List<KitType>? _kitTypes;
    private List<MyOrderItem> historycOrders = new();
    private PendingOrderItem pendingOrder = new();

    // ============================================================================
    // 3) 📄 PAGINACIÓN (DESKTOP/MÓVIL)
    // ============================================================================
    /*Navigation*/
    private int currentPageDesktop = 1;
    private int pageSizeDesktop = 7;
    private int currentPageMobile = 1;
    private int pageSizeMobile = 1;

    // Computed Properties para paginación
    private IEnumerable<MyOrderItem> PagedDesktop =>
        historycOrders
            .Skip((currentPageDesktop - 1) * pageSizeDesktop)
            .Take(pageSizeDesktop);

    private IEnumerable<MyOrderItem> PagedMobile =>
        historycOrders
            .Skip((currentPageMobile - 1) * pageSizeMobile)
            .Take(pageSizeMobile);

    private int TotalPagesDesktop =>
        historycOrders.Count == 0
            ? 1
            : (int)Math.Ceiling(historycOrders.Count / (double)pageSizeDesktop);

    private int TotalPagesMobile =>
        historycOrders.Count == 0
            ? 1
            : (int)Math.Ceiling(historycOrders.Count / (double)pageSizeMobile);

    // ============================================================================
    // 4) 🎛️ NAVEGACIÓN PAGINACIÓN
    // ============================================================================
    private void NextDesktop() => currentPageDesktop = Math.Min(currentPageDesktop + 1, TotalPagesDesktop);
    private void PrevDesktop() => currentPageDesktop = Math.Max(currentPageDesktop - 1, 1);
    private void NextMobile() => currentPageMobile = Math.Min(currentPageMobile + 1, TotalPagesMobile);
    private void PrevMobile() => currentPageMobile = Math.Max(currentPageMobile - 1, 1);

    // 🔗 Navegar a seguimiento de orden específica
    private void Seguimiento(int orderId)
    {
        Navigation.NavigateTo($"/Seguimiento?order={orderId}", forceLoad: true);
    }

    // ============================================================================
    // 5) 🔄 OPERACIONES PRINCIPALES (TASKS)
    // ============================================================================
    // 🎯 Seleccionar tab/kit y cargar orden pendiente
    private async Task SelectTab(int tab)
    {
        if (tab <= 0 || tab == selectedTab) return;

        selectedTab = tab;
        try
        {
            var result = await OrderService.GetMyPendingOrderAsync(kitTypeId: tab);
            if (result is null)
            {
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }
            pendingOrder = result.Order;
        }
        catch
        {
            isError = true;
        }
        StateHasChanged();
    }

    // 👕 Ir a selección de prendas (móvil)
    private async Task GoGarments(KitType kit)
    {
        KitSelectionState.Set(kit);
        await KitSelectionState.SaveAsync();
        
        if (selectedTab == 2) // Modal para kit 2
        {
            if (modalRef is not null)
            {
                await modalRef.OpenAsync();
                StateHasChanged();
            }
        }
        else // Navegación normal
        {
            Navigation.NavigateTo("/Garments", forceLoad: true);
        }
    }

    // 👕 Ir a selección de prendas (desktop)
    private async Task GoGarmentsDesktop()
    {
        var kit = _kitTypes?.FirstOrDefault(k => k.KitTypeId == selectedTab);
        if (kit is null) return;

        KitSelectionState.Set(kit);
        await KitSelectionState.SaveAsync();
        
        if (selectedTab == 2)
        {
            if (modalRef is not null) await modalRef.OpenAsync();
        }
        else
        {
            Navigation.NavigateTo("/Garments", forceLoad: true);
        }
    }

    // ============================================================================
    // 6) 🚀 INICIALIZACIÓN (OnInitializedAsync)
    // ============================================================================
    private DataUserSession? _sessionData = new();
    private bool esMujer;
    private bool menosDeUnMes;
    private bool masDeUnAnio;
    private bool masDeDosAnios;

    // 🎬 Carga inicial completa de datos
    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500); // UX loading
        
        try
        {
            // 1️⃣ Sesión + Tipos de kit
            _sessionData = await AuthService.GetSessionDataAsync();
            _kitTypes = await KitService.GetKitTypesAsync();

            // 2️⃣ Lógica de elegibilidad por antigüedad/género
            if (_sessionData is not null)
            {
                var today = DateTime.Today;
                var act = _sessionData.ActivationDate ?? today;

                esMujer = string.Equals(_sessionData.Gender, "Femenino", StringComparison.OrdinalIgnoreCase);
                menosDeUnMes = act >= today.AddMonths(-1);
                masDeUnAnio = act <= today.AddYears(-1);
                masDeDosAnios = act <= today.AddYears(-2);
            }

            // 3️⃣ Validaciones críticas
            if (_kitTypes is null)
            {
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }
            isEmpty = _kitTypes.Count == 0;

            // 4️⃣ Historial de órdenes
            var result = await OrderService.GetMyOrdersHistoryAsync();
            if (result is null)
            {
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }
            historycOrders = result.Orders;
        }
        catch
        {
            isError = true;
        }
        finally
        {
            isLoaded = true; // ✅ Mostrar contenido
        }
    }
}

