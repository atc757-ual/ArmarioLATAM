                                        <td>Pendiente</td>
                                    </tr>
                                    <tr class="latam-kit-table-footer">
                                        <td colspan="5">
                                            <button type="button" @onclick="GoNuevoIngresoDesktop" class="latam-btn latam-btn--primary">
                                                Solicitar uniforme
                                            </button>
                                        </td>
