@page "/Dashboard"
@using ArmarioLATAM.Components.Models
@using ArmarioLATAM.Services
@inject NavigationManager Navigation
@inject IKitService KitService
@inject LocalStorageService LocalStorage
@inject KitSelectionState KitSelectionState
 

       
                    <div class="latam-kit-wrapper">
                        <button class="latam-kit @(kit.KitTypeId == selectedTab ? "active" : "")"
                                @onclick="() => SelectTab(kit.KitTypeId)">
                            @if (kit.KitTypeId == selectedTab)
                            {
                                <img src="@kit.ImageURLSelect" alt="" />
                            }
                            else
                            {
                                <img src="@kit.ImageURL" alt="" />
                            }
                            <span class="latam-kit-label">@kit.Name</span>
                        </button>
                        <!-- TAB Mobile con botones -->
                        @if (selectedTab == kit.KitTypeId && kit.KitTypeId == 1)
                        {
                           <div class="latam-kit-panel latam-kit-panel--mobile">
                                <table class="latam-kit-table latam-kit-table--details">
                                    <tbody>
                                        @if (isError)
                                        {
                                            <tr class="latam-kit-table-empty">
                                                <td colspan="2">
                                                    <img src="images/ico_bloqueo.svg" />
                                                    <p>
                                                        Ha ocurrido un problema al cargar el kit,<br />
                                                        por favor vuelve a intentarlo.
                                                    </p>
                                                    <div class="margin-top-base">
                                                        <button @onclick="ReintentarEmergency" type="button" class="latam-btn latam-btn--primary">Reintentar </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        else if (isEmpty)
                                        {
                                            <tr class="latam-kit-table-empty">
                                                <td colspan="2">
                                                    <img src="images/ico_bag_cross.svg" />
                                                    <p>Este Kit no esta disponible para ser solicitado.</p>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td>Código</td>
                                                <td>KIT2-l</td>
                                            </tr>
                                            <tr>
                                                <td>Nombre kit</td>
                                                <td>Apto Outdoor Unisex Inicial</td>
                                            </tr>
                                            <tr>
                                                <td>Orden</td>
                                                <td>Sin orden</td>
                                            </tr>
                                            <tr>
                                                <td>Fecha de creación</td>
                                                <td>12/12/2025</td>
                                            </tr>
                                            <tr>
                                                <td>Estado</td>
                                                <td>Pendiente</td>
                                            </tr>
                                            <tr class="separator">
                                            </tr>
                                            <tr class="latam-kit-table-footer">
                                                <td colspan="2">
                                                    <button @onclick="() => GoNuevoIngreso(kit)" type="button" class="latam-btn latam-btn--primary">
                                                        Solicitar uniforme
                                                    </button>
                                                </td>
                                            </tr>
                                        }

                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (selectedTab == kit.KitTypeId && kit.KitTypeId == 2)
                        {
                            <div class="latam-kit-panel latam-kit-panel--mobile">
                                <table class="latam-kit-table latam-kit-table--details">
                                    <tbody>
                                        @if (isError)
                                        {
                                            <tr class="latam-kit-table-empty">
                                                <td colspan="2">
                                                    <img src="images/ico_bloqueo.svg" />
                                                    <p>
                                                        Ha ocurrido un problema al cargar el kit,<br />
                                                        por favor vuelve a intentarlo.
                                                    </p>
                                                    <div class="margin-top-base">
                                                        <button @onclick="ReintentarEmergency" type="button" class="latam-btn latam-btn--primary">Reintentar </button>
