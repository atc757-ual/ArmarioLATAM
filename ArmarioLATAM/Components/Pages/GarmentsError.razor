@page "/GarmentsError"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject GarmentSelectionState GarmentSelectionState
@inject KitSelectionState KitSelectionState


<section class="latam-section">
    <div class="page-title">@KitSelectionState.Name</div>
    <Separator />
    <div class="nuevo-ingreso-header">
        <span class="label">Comprobante de solicitud:</span><br class="mobile-break" /> 
        <span class="label">Kit @KitSelectionState.Description</span>
    </div>

        <div class="latam-error-card">
            <div class="latam-error-header">
                <img src="images/ico_bloqueo_accent.svg" alt="alert" class="" />
                <span>No se ha realizado la solicitud</span>
            </div>
            <Separator></Separator>
            <div class="latam-error-body margin-bottom-base">
               <p class="padding-bottom-m"> Se produjo un error al momento de generar la solicitud por lo que no ha sido enviada.<br />
                Por favor, inténtalo nuevamente.</p>
            </div>
        </div>
            <div class="latam-btn-row">
                <button type="button" class="latam-btn latam-btn--primary " @onclick="GoNext">Volver al inicio</button>
            </div>
 
</section>
<ValidaSession/>
@code {
    void GoNext()
    {
        Navigation.NavigateTo("/Dashboard", forceLoad: true);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 1. Cargar selección desde localStorage
            if (KitSelectionState.IsEmpty)
            {
                await KitSelectionState.LoadAsync();
            }

            if (KitSelectionState.IsEmpty)
            {
                Navigation.NavigateTo("/Dashboard", forceLoad: true);
                return;
            }
            await KitSelectionState.ClearAsync();
            await GarmentSelectionState.ClearAsync();
            StateHasChanged(); // un solo render extra tras cargar todo
        }

    }


}
