@page "/NuevoIngreso"
@using ArmarioLATAM.Services
@using ArmarioLATAM.Components.Models
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject IGarmentService GarmentService
@inject GarmentSelectionState SelectionState
@inject KitSelectionState KitSelectionState
@rendermode InteractiveServer


<ValidaSession/>
@if (!isLoaded)
{
    <LoadPage />
}else{
<section class="latam-section">
        <div class="page-title">@KitSelectionState.Name</div>
    <Separator />
    <div class="nuevo-ingreso-header">
            <span class="label">Prendas asignadas para:</span><br class="mobile-break" /> 
            <span class="label">@KitSelectionState.Description</span>
    </div>


    @if (errorSection)
    {
        <div class="latam-error-card">
            <div class="latam-error-header">
                <img src="images/ico_bloqueo_accent.svg" alt="alert" class="" />
                <span>No podemos mostrar las prendas del kit</span>
            </div>
            <Separator></Separator>
            <div class="latam-error-body">
                En estos momentos no es posible mostrar las prendas asignadas a este Kit.<br />
                Por favor, inténtalo nuevamente
            </div>
            <Separator></Separator>
            <div class="latam-error-footer">
                <button class="latam-btn latam-btn--primary" type="button" @onclick="Reintentar">
                    Reintentar
                </button>
                <a class="latam-link-danger" @onclick="GoInicio">
                    Volver al inicio
                </a>
            </div>
        </div>
    }
    else if (isEmptyGarments)
    {
        <p>No hay prendas.</p>
    }

    else
    {
        <div class="garment-list">
            @foreach (var garment in _garments)
            {
                    <ProductCard garments=garment 
                        OnChanged="OnGarmentChanged" />
            }

        </div>
    }
    <Separator />
    <div class="redirects-footer">
        <button type="button"
                class="latam-back-link"
                @onclick="GoBack">
            <img src="images/ico_arrow_left.svg" />
            <span> Volver</span>
        </button>

            @if (_garments.Count > 0 )
        {
            <div class="latam-btn-row">
                <button type="button" class="latam-btn latam-btn--primary " @onclick="GoNext">Continuar</button>
            </div>
        }
        else
        {
            <div class="latam-btn-row">
                <button type="button" class="latam-btn latam-btn--primary " disabled>
                    Continuar
                </button>
            </div>
        }
    </div>
</section>
}
@code {

    private List<Garment> _garments { get; set; } = new();
    private bool isEmptyGarments;
    private bool isLoaded = false;
    private bool errorSection;

    void GoBack()
    {
        SelectionState.Clear();
        JS.InvokeVoidAsync("history.back");
    }

    void GoNext()
    {
        SelectionState.SetSelections(_selected.Values);
        Navigation.NavigateTo("/NuevoIngresoResumen");
    }
    void Reintentar()
    {
        
    }
    void GoInicio()
    {
        SelectionState.Clear();
        Navigation.NavigateTo("/");
    }



    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);
        try
        {
            _garments = await GarmentService.GetGarmentsAsync() ?? new List<Garment>();
            if (_garments is null)
            {
                // no token o token caducado → sesión expirada
                Navigation.NavigateTo("/");
                return;
            }
            
            isEmptyGarments = _garments == null || !_garments.Any();
            errorSection = false;
        }
        catch
        {
            errorSection = true;
            isEmptyGarments = false;
        }
        finally
        {
            isLoaded = true;
        }
    }
    private readonly Dictionary<int, GarmentSelection> _selected = new();

    private void OnGarmentChanged(GarmentSelection sel)
    {
        // Solo guardamos si Quantity > 0
        if (sel.Quantity > 0)
            _selected[sel.GarmentId] = sel;
        else
            _selected.Remove(sel.GarmentId);
    }

    // Cuando necesites los seleccionados:
    private IEnumerable<GarmentSelection> GetSelectedGarments()
        => _selected.Values;
}

