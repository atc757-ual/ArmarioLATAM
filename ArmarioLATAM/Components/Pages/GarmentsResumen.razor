@page "/GarmentsResumen"
@using ArmarioLATAM.Services
@using ArmarioLATAM.Components.Models
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject DetailDeliveredState DetailDeliveredState
@inject GarmentSelectionState GarmentSelectionState
@inject KitSelectionState KitSelectionState
@inject OrderState OrderState
@inject IOrderService OrderService
@rendermode InteractiveServer

<!-- ==================== UI ==================== -->
@if (!isLoaded)
{
    <LoadPage />
}
else
{
    <section class="latam-section">
        <!-- Título kit -->
        <div class="page-title">@KitSelectionState.Name</div>
        <Separator />

        <!-- Header resumen -->
        <div class="nuevo-ingreso-header">
            <span class="label">Resumen de solicitud:</span><br class="mobile-break" />
            <span class="label">@KitSelectionState.Description</span>
        </div>

        <!-- Lista garments -->
        <div class="summary-list">
            @foreach (var item in GarmentSelectionState.SelectedGarments)
            {
                <article class="summary-item">
                    <img src="@item.ImageURL" class="summary-image" alt="@item.Name" />

                    <!-- Info principal -->
                    <div class="summary-main">
                        <div class="summary-head">
                            <span class="summary-data-label">Name</span>
                            <span class="summary-data-value">@item.Name</span>
                        </div>

                        <!-- Mobile: talla o idiomas -->
                        <div class="summary-data--mobile">
                            @if (string.IsNullOrEmpty(item.NativeLanguage) &&
                                                string.IsNullOrEmpty(item.SecondLanguage) &&
                                                string.IsNullOrEmpty(item.ThirdLanguage))
                            {
                                <span class="summary-data-label">Talla</span>
                                <span class="summary-data-value">@item.Size</span>
                            }
                            else
                            {
                                var nativeFlag = GetFlagPath(item.NativeLanguage);
                                var secondFlag = GetFlagPath(item.SecondLanguage);
                                var thirdFlag = GetFlagPath(item.ThirdLanguage);

                                <div class="flag-language">
                                    <span class="summary-data-label">
                                        @if (nativeFlag is not null)
                                        {
                                            <img src="@nativeFlag" class="flag-language-icon" />
                                        }
                                        @if (secondFlag is not null)
                                        {
                                            <img src="@secondFlag" class="flag-language-icon" />
                                        }
                                        @if (thirdFlag is not null)
                                        {
                                            <img src="@thirdFlag" class="flag-language-icon" />
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Desktop: talla + qty -->
                    <div class="summary-data--desktop">
                        <div class="summary-size-block">
                            @if (string.IsNullOrEmpty(item.NativeLanguage) &&
                                                string.IsNullOrEmpty(item.SecondLanguage) &&
                                                string.IsNullOrEmpty(item.ThirdLanguage))
                            {
                                <span class="summary-data-label">Talla</span>
                                <span class="summary-data-value">@item.Size</span>
                            }
                            else
                            {
                                var nativeFlag = GetFlagPath(item.NativeLanguage);
                                var secondFlag = GetFlagPath(item.SecondLanguage);
                                var thirdFlag = GetFlagPath(item.ThirdLanguage);

                                <div>
                                    <span class="summary-data-label">Idiomas</span>
                                    <span class="summary-data-value">
                                        @if (nativeFlag is not null)
                                        {
                                            <img src="@nativeFlag" class="flag-language-icon" />
                                        }
                                        @if (secondFlag is not null)
                                        {
                                            <img src="@secondFlag" class="flag-language-icon" />
                                        }
                                        @if (thirdFlag is not null)
                                        {
                                            <img src="@thirdFlag" class="flag-language-icon" />
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                        <div class="summary-qty-block">
                            <span class="summary-data-label">Cantidad</span>
                            <span class="summary-data-value">@item.Quantity</span>
                        </div>
                    </div>
                </article>
            }
        </div>

        <Separator />

        <!-- Botones footer -->
        <div class="redirects-footer">
            <button type="button" class="latam-back-link" @onclick="GoBack">
                <img src="images/ico_arrow_left.svg" />
                <span>Volver</span>
            </button>
            <div class="latam-btn-row">
                <button type="button"
                        class="latam-btn latam-btn--primary"
                        disabled="@isLoadingButton"
                        @onclick="CreateOrder">
                    @(isLoadingButton ? "Enviando solicitud..." : "Confirmar solicitud")
                </button>
            </div>
        </div>
    </section>
    <ValidaSession />
}

<!-- ==================== LÓGICA ==================== -->
@code {
    // Estados carga
    private bool isLoaded = false;
    private bool isLoadingButton = false;

    // ==================== MAPEO IDIOMAS ====================
    private readonly Dictionary<string, string> LanguageFlagMap =
        new(StringComparer.OrdinalIgnoreCase)
        {
            ["ES"] = "images/flags/ES.svg",
            ["EN"] = "images/flags/EN.svg",
            ["FR"] = "images/flags/FR.svg",
            ["IT"] = "images/flags/IT.svg",
            ["DE"] = "images/flags/DE.svg",
            ["PT"] = "images/flags/PT.svg"
        };

    // Obtiene path bandera por código idioma
    string? GetFlagPath(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return null;
        return LanguageFlagMap.TryGetValue(code, out var path) ? path : null;
    }

    // ==================== INIT ====================
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Carga datos localStorage
            if (KitSelectionState.IsEmpty || GarmentSelectionState.IsEmpty)
            {
                await KitSelectionState.LoadAsync();
                await GarmentSelectionState.LoadAsync();
            }

            // Valida datos requeridos
            if (KitSelectionState.IsEmpty || GarmentSelectionState.IsEmpty)
            {
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }

            isLoaded = true;
            StateHasChanged();
        }
    }

    // ==================== CREAR ORDEN ====================
    async Task CreateOrder()
    {
        // Validación rápida
        if (KitSelectionState.KitTypeId is null || !GarmentSelectionState.SelectedGarments.Any())
        {
            return;
        }

        isLoadingButton = true;
        await Task.Delay(500); // UX feedback

        // Carga detalles entrega
        await DetailDeliveredState.LoadAsync();

        // ==================== DTO ORDEN ====================
        var dto = new CreateOrder
        {
            KitTypeId = KitSelectionState.KitTypeId.Value,
            Items = GarmentSelectionState.SelectedGarments
                .Select(g => new CreateOrderItem
                {
                    GarmentId = g.GarmentId,
                    Size = g.Size,
                    Quantity = g.Quantity,
                    Languages = string.Join(",",
                        new[] { g.NativeLanguage, g.SecondLanguage, g.ThirdLanguage }
                            .Where(code => !string.IsNullOrWhiteSpace(code)))
                }).ToList(),
            Motive = DetailDeliveredState.Detail.Motive,
            DetailMotive = DetailDeliveredState.Detail.DetailMotive,
            Province = DetailDeliveredState.Detail.Province,
            District = DetailDeliveredState.Detail.District,
            Address = DetailDeliveredState.Detail.Address,
            AddressReference = DetailDeliveredState.Detail.Reference
        };

        // API call
        var response = await OrderService.CreateOrderAsync(dto);

        // ==================== MANEJO RESPUESTA ====================
        if (response is null)
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/GarmentsError", forceLoad: true);
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<CreateOrderResponse>();
        if (result is null)
        {
            Navigation.NavigateTo("/GarmentsError", forceLoad: true);
            return;
        }

        // ==================== ÉXITO ====================
        string orderNumber = result.OrderId.ToString("D5");
        var fecha = DateTime.ParseExact(result.Fecha!, "yyyy-MM-dd", null);
        string orderDate = fecha.ToString("dd/MM/yyyy");

        // Guarda estado orden
        OrderState.Set(orderNumber, orderDate);
        await OrderState.SaveAsync();

        // Redirige comprobante
        Navigation.NavigateTo("/GarmentsComprobante", forceLoad: true);
    }

    // ==================== NAVEGACIÓN ====================
    async Task GoBack()
    {
        // History back suave
        await JS.InvokeVoidAsync("history.back");
    }
}
