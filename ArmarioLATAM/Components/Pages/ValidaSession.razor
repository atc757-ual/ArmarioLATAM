@rendermode InteractiveServer
@using ArmarioLATAM.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation



@if (showToast){
    <Toast Visible=true 
       Type="info" 
       Title="Sesión expirada" 
       Message="Tu sesión ha expirado. Por favor, inicia sesión de nuevo." />
}

@code {
    private bool showToast = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var uri = Navigation.ToBaseRelativePath(Navigation.Uri);
        var isHome = string.IsNullOrEmpty(uri) || uri.Equals("home", StringComparison.OrdinalIgnoreCase);
        var isValid = await AuthService.IsSessionValidAsync();
        showToast = !isValid;
        if (!isValid && !isHome)
        {
            Navigation.NavigateTo("/");
        }
    }
}


