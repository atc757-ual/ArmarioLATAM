@inherits LayoutComponentBase
@using ArmarioLATAM.Services
@inject NavigationManager Navigation
@inject IAuthService AuthService

<div class="app-shell">

    <header class="app-header">
        <div class="header-left">
            <img src="images/logo.svg" alt="Logo" class="header-logo" />
        </div>

        <NavMenu />
    </header>
    <main class="app-main">
            @Body
    </main>
    <footer class="app-footer">
        <img src="images/logo_footer.svg" alt="MiApp" class="footer-logo-img" />
        <span class="footer-text">
            Si tienes alguna duda o requieres soporte técnico por favor escríbenos a
            armariolatam@mail.com
        </span>
    </footer>

</div>


@code {
    private bool _checkedSessionFromStorage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _checkedSessionFromStorage)
            return;

        _checkedSessionFromStorage = true;

        var uri = Navigation.ToBaseRelativePath(Navigation.Uri); // "" cuando es "/"
        var isHome = string.IsNullOrEmpty(uri) || uri.Equals("home", StringComparison.OrdinalIgnoreCase);

        var isValid = await AuthService.IsSessionValidAsync();

        if (!isValid && !isHome)
        {
            Navigation.NavigateTo("/");
        }
        // IMPORTANTE: si estás en "/" no redirijas otra vez, o nunca saldrás de login
    }
}


