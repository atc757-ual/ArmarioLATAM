@rendermode InteractiveServer

@if (isLogin)
{
    <div class="header-right">
        <button class="latam-account-toggle" @onclick="ToggleMenu">
            <img class="w-36"src="images/ico_burger.svg" alt="Menú" />
        </button>
    </div>
}


@* Menú cuenta: dropdown (desktop) / modal (mobile) *@
@if (isAccountOpen)
{
    <div class="latam-account-overlay" @onclick="CloseMenu">
        <div class="latam-account-panel" @onclick:stopPropagation>
            <header class="latam-account-header">
                <img src="images/logo_footer.svg" alt="LATAM" class="latam-account-logo" />
                <button class="latam-account-close" @onclick="CloseMenu">
                    <img class="w-28" src="images/ico_close.svg" />
                </button>
            </header>

            <div class="latam-account-body">
                <p class="fs-16 fw-semibold">Luisa Fernanda Cardenas</p>
                <p class="fs-14">BP: 4673371</p>
            </div>

            <footer class="latam-account-footer">
                <button class="latam-account-logout">
                    <span>
                        <img class="w-24" src="images/ico_logout.svg" />
                    </span>
                    <span>Cerrar sesión</span>
                </button>
            </footer>
        </div>
    </div>
}
@code {
    private bool isLogin { get; set; } = false;
    private bool IsLoading { get; set; } = false;
    private bool isAccountOpen { get; set; } = false;

    private void ToggleMenu()
    {
        isAccountOpen = true;
    }
    private void CloseMenu()
    {
        isAccountOpen = false;
    }


}